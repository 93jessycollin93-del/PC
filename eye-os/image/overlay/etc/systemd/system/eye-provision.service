[Unit]
Description=eYe OS first-boot provisioning (per-machine secrets)
After=local-fs.target
# Nothing that needs the token may start before this has produced it. The
# matching Requires= lives in the consumers, since RequiredBy= is an
# [Install] directive and silently does nothing here.
Before=eye-pc.service eye-hostd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/eye-os/bin/eye-provision
Environment=PYTHONUNBUFFERED=1
# Runs as root because it writes a root-owned 0600 file in /etc, and only
# for as long as that takes.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
