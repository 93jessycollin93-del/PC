[Unit]
Description=eYe OS late-boot hardening
Documentation=file:/etc/eye-os/hardening.conf
# Runs last on purpose: locking module loading before the session's drivers
# are in would leave the machine without a display or input.
After=graphical.target eye-kiosk.service
Wants=graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/eye-os/bin/eye-harden
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical.target
