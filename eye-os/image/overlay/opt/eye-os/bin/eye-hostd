#!/usr/bin/env python3
"""
eye-hostd — the shell's host agent.

Two jobs, one process:

  1. Serve the built shell as static files.
  2. Expose the machine's filesystem at /api/fs, which is what turns the
     shell's VFS probe from "localStorage" into "a real disk".

Deliberately stdlib-only. The image already carries a browser and a kernel;
adding a package manager's worth of web framework to a kiosk that serves one
directory on loopback is not a trade worth making.

Scope of trust: this binds to 127.0.0.1 only and is reachable solely by the
browser running on the same machine. It is not authenticated, because on this
image there is no second principal to authenticate against — the kiosk user
already owns the files it exposes. Do not bind it to 0.0.0.0.
"""

from __future__ import annotations

import json
import os
import shutil
import sys
from http.client import HTTPConnection
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse

HOST = "127.0.0.1"
PORT = int(os.environ.get("EYE_PORT", "7788"))
STATIC_ROOT = Path(os.environ.get("EYE_STATIC", "/opt/eye-os/session")).resolve()
FILES_ROOT = Path(os.environ.get("EYE_FILES", "/var/lib/eye-os/files")).resolve()

# The PC session ships its own Express server for the endpoints its AI apps
# call. When it is running, anything under /api that is not /api/fs is handed
# to it, so the browser sees exactly one origin and the PC application needs
# no change to run here. When it is absent — the recovery shell, or a build
# without it — those routes answer 503 rather than hanging.
UPSTREAM_HOST = os.environ.get("EYE_UPSTREAM_HOST", "127.0.0.1")
UPSTREAM_PORT = int(os.environ.get("EYE_UPSTREAM_PORT", "5000"))
UPSTREAM_TIMEOUT = float(os.environ.get("EYE_UPSTREAM_TIMEOUT", "120"))

# The session server authenticates its dangerous routes with a shared token.
# eye-hostd holds it and injects it, so the token never reaches the browser:
# script running in the renderer cannot read it, and anything that reaches
# port 5000 without going through here is refused by the session server.
# JACKIE_API_TOKEN is the name the session server reads, and systemd hands us
# the same EnvironmentFile — so accept either spelling rather than duplicating
# the secret under a second name.
UPSTREAM_TOKEN = os.environ.get("EYE_UPSTREAM_TOKEN") or os.environ.get("JACKIE_API_TOKEN", "")
UPSTREAM_TOKEN_HEADER = os.environ.get("EYE_UPSTREAM_TOKEN_HEADER", "x-jackie-token")

# Injecting the token would otherwise hand the renderer full use of the
# routes it protects, which defeats the point — a compromised page would just
# ask this proxy to do the dangerous thing on its behalf. So the routes that
# execute commands, run builds or write the host filesystem are refused here,
# ahead of the session server, and turning one back on is a deliberate edit to
# /etc/eye-os/session.conf rather than a side effect of anything.
DEFAULT_BLOCKED = "/api/shell/,/api/build/,/api/term-fs/"
BLOCKED_PREFIXES = tuple(
    prefix.strip()
    for prefix in os.environ.get("EYE_BLOCKED_UPSTREAM", DEFAULT_BLOCKED).split(",")
    if prefix.strip()
)

CONTENT_TYPES = {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".mjs": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".svg": "image/svg+xml",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".webp": "image/webp",
    ".ico": "image/x-icon",
    ".woff2": "font/woff2",
    ".map": "application/json; charset=utf-8",
}


class PathOutsideRoot(Exception):
    """A request tried to address something outside FILES_ROOT."""


def resolve_vfs(raw: str) -> Path:
    """
    Map a VFS-absolute path onto the host filesystem.

    Traversal is blocked after resolution rather than by string inspection:
    `..` sequences, absolute re-roots and symlinks all collapse first, and the
    result must still sit inside FILES_ROOT. Checking the resolved path is the
    only version of this test that a symlink cannot walk around.
    """
    candidate = (FILES_ROOT / raw.lstrip("/")).resolve()
    if candidate != FILES_ROOT and FILES_ROOT not in candidate.parents:
        raise PathOutsideRoot(raw)
    return candidate


def to_vfs(path: Path) -> str:
    relative = path.relative_to(FILES_ROOT).as_posix()
    return "/" + relative if relative != "." else "/"


class Handler(BaseHTTPRequestHandler):
    server_version = "eye-hostd/1.0"
    protocol_version = "HTTP/1.1"

    # ---------------------------------------------------------------- utils

    def log_message(self, fmt: str, *args) -> None:
        # journald already timestamps; stderr keeps it in `journalctl -u`.
        sys.stderr.write("eye-hostd: " + (fmt % args) + "\n")

    def _send(self, status: int, body: bytes, content_type: str) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        # The shell is served from this same origin; nothing else may embed it.
        self.send_header("X-Frame-Options", "DENY")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _text(self, status: int, text: str) -> None:
        self._send(status, text.encode("utf-8"), "text/plain; charset=utf-8")

    def _json(self, status: int, payload: object) -> None:
        self._send(status, json.dumps(payload).encode("utf-8"), "application/json; charset=utf-8")

    def _query_path(self) -> str | None:
        params = parse_qs(urlparse(self.path).query)
        values = params.get("path")
        return values[0] if values else None

    def _body(self) -> bytes:
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(length) if length else b""

    # ------------------------------------------------------------- fs verbs

    def _fs(self, action: str) -> None:
        raw = self._query_path()
        if raw is None:
            self._text(400, "missing ?path=")
            return
        try:
            target = resolve_vfs(unquote(raw))
        except PathOutsideRoot:
            self._text(403, "path escapes the files root")
            return

        try:
            if action == "read":
                if not target.is_file():
                    self._text(404, "not found")
                    return
                self._send(200, target.read_bytes(), "text/plain; charset=utf-8")

            elif action == "write":
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(self._body())
                self._text(200, "ok")

            elif action == "mkdir":
                target.mkdir(parents=True, exist_ok=True)
                self._text(200, "ok")

            elif action == "remove":
                if target == FILES_ROOT:
                    self._text(403, "refusing to remove the files root")
                    return
                if target.is_dir():
                    shutil.rmtree(target)
                elif target.exists():
                    target.unlink()
                self._text(200, "ok")

            elif action == "list":
                if not target.is_dir():
                    self._json(200, [])
                    return
                entries = []
                for child in sorted(target.iterdir()):
                    try:
                        info = child.stat()
                    except OSError:
                        continue  # vanished mid-listing
                    entries.append(
                        {
                            "path": to_vfs(child),
                            "kind": "dir" if child.is_dir() else "file",
                            "size": 0 if child.is_dir() else info.st_size,
                            "modified": int(info.st_mtime * 1000),
                        }
                    )
                entries.sort(key=lambda e: (e["kind"] != "dir", e["path"]))
                self._json(200, entries)

            else:
                self._text(404, "unknown fs action")

        except PermissionError:
            self._text(403, "permission denied")
        except OSError as error:
            self._text(500, f"{type(error).__name__}: {error}")

    # ---------------------------------------------------------------- static

    def _static(self) -> None:
        requested = unquote(urlparse(self.path).path)
        if requested in ("", "/"):
            requested = "/index.html"

        candidate = (STATIC_ROOT / requested.lstrip("/")).resolve()
        inside = candidate == STATIC_ROOT or STATIC_ROOT in candidate.parents

        # Single-page fallback: unknown paths render the shell rather than 404,
        # but only after the traversal check, never as a way around it.
        if not inside or not candidate.is_file():
            candidate = STATIC_ROOT / "index.html"
            if not candidate.is_file():
                self._text(404, "shell not installed")
                return

        content_type = CONTENT_TYPES.get(candidate.suffix, "application/octet-stream")
        self._send(200, candidate.read_bytes(), content_type)

    # ----------------------------------------------------------- upstream

    def _proxy(self) -> None:
        """
        Hand a request to the session's own server.

        Streamed rather than buffered: the PC session's AI routes return
        server-sent events, and reading those to completion before replying
        would turn a live token stream into a long silence followed by a wall
        of text.
        """
        path = urlparse(self.path).path
        if path.startswith(BLOCKED_PREFIXES):
            self.log_message("blocked upstream route %s", path)
            self._json(
                403,
                {
                    "error": "route disabled by eYe OS policy",
                    "path": path,
                    "hint": "EYE_BLOCKED_UPSTREAM in /etc/eye-os/session.conf",
                },
            )
            return

        body = self._body()
        try:
            upstream = HTTPConnection(UPSTREAM_HOST, UPSTREAM_PORT, timeout=UPSTREAM_TIMEOUT)
            headers = {
                key: value
                for key, value in self.headers.items()
                # Hop-by-hop headers belong to this connection, not the next
                # one; re-sending them corrupts the upstream framing. The
                # token header is dropped too: the browser does not get to
                # choose what this proxy authenticates as.
                if key.lower()
                not in ("host", "connection", "keep-alive", "transfer-encoding", UPSTREAM_TOKEN_HEADER)
            }
            headers["Host"] = f"{UPSTREAM_HOST}:{UPSTREAM_PORT}"
            if UPSTREAM_TOKEN:
                headers[UPSTREAM_TOKEN_HEADER] = UPSTREAM_TOKEN
            upstream.request(self.command, self.path, body=body or None, headers=headers)
            response = upstream.getresponse()
        except (ConnectionRefusedError, OSError) as error:
            self._json(
                503,
                {
                    "error": "session server unavailable",
                    "detail": f"{type(error).__name__}: {error}",
                    "hint": f"nothing is listening on {UPSTREAM_HOST}:{UPSTREAM_PORT}",
                },
            )
            return

        try:
            self.send_response(response.status)
            for key, value in response.getheaders():
                if key.lower() in ("connection", "keep-alive", "transfer-encoding", "content-length"):
                    continue
                self.send_header(key, value)
            # Length is unknown for a stream, so close-delimit the body. HTTP/1.0
            # framing is the one both sides agree on without chunked encoding.
            self.send_header("Connection", "close")
            self.protocol_version = "HTTP/1.0"
            self.end_headers()
            while True:
                chunk = response.read(8192)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass  # the browser navigated away mid-stream
        finally:
            upstream.close()

    # ---------------------------------------------------------------- routes

    def _route(self) -> None:
        path = urlparse(self.path).path
        if path == "/api/fs/health":
            self._json(200, {"backend": "host", "root": str(FILES_ROOT)})
        elif path.startswith("/api/fs/"):
            self._fs(path[len("/api/fs/") :])
        elif path.startswith("/api/"):
            self._proxy()
        elif self.command in ("GET", "HEAD"):
            self._static()
        else:
            self._text(405, "method not allowed")

    do_GET = _route
    do_HEAD = _route
    do_PUT = _route
    do_POST = _route
    do_DELETE = _route


def main() -> int:
    FILES_ROOT.mkdir(parents=True, exist_ok=True)
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"eye-hostd: serving {STATIC_ROOT} and {FILES_ROOT} on http://{HOST}:{PORT}")
    sys.stdout.flush()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
