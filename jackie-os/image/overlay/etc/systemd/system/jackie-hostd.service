[Unit]
Description=Jackie OS host agent (shell static files + filesystem API)
Documentation=file:/opt/jackie-os/README
After=local-fs.target
Before=jackie-kiosk.service

[Service]
Type=simple
User=jackie
Group=jackie
ExecStart=/opt/jackie-os/bin/jackie-hostd
Environment=JACKIE_STATIC=/opt/jackie-os/shell
Environment=JACKIE_FILES=/var/lib/jackie-os/files
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=1

# The agent serves one directory over loopback and needs nothing else. These
# are the confinement knobs that cost nothing to switch on.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/jackie-os
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
