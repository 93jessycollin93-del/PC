[Unit]
Description=Jackie's PC application server
Documentation=file:///opt/jackie-pc/BOOT-NOTES.md
After=network.target jackie-firewall.service
Wants=jackie-firewall.service

[Service]
Type=simple
User=jackie
Group=jackie
WorkingDirectory=/opt/jackie-pc
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=JACKIE_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
# JACKIE_API_TOKEN is deliberately NOT set. The bundled frontend never sends an
# x-jackie-token header, so setting one would 403 the app's own shell, build and
# term-fs features. Reachability is restricted by jackie-firewall.service
# instead, which is what actually keeps these endpoints off the network.
EnvironmentFile=-/etc/jackie-pc/env
ExecStart=/usr/bin/node /opt/jackie-pc/server.cjs
Restart=always
RestartSec=2

# The live filesystem is a RAM overlay, but keep the blast radius small anyway.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jackie-pc/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
